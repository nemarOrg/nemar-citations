  "citation_details": [
    {
      "title": "Moral conviction and metacognitive ability shape multiple stages of information processing",
      "author": "Keith Jonathon Yoder, Jean Decety",
      "venue": "UC San Diego",
      "year": 2026,
      "url": "https://doi.org/10.82901/nemar.on004067.v1.0.0",
      "cited_by": 0,
      "abstract": "This dataset comprises human electroencephalography (EEG) recordings from 80 participants engaged in a moral decision-making task. Participants evaluated their attitudes toward sociopolitical issues, then viewed protest photographs while receiving information about social support levels for each issue. The study investigates how moral conviction and metacognitive ability influence neural processing stages during social judgment and attitude formation.",
