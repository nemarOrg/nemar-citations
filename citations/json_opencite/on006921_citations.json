  "citation_details": [
    {
      "title": "High Density Resting State EEG of Phantom Limb Pain and Controls",
      "author": "M. Ramne, S. Damercheli, F. Apelgren, I. Pettersson, E. Lendaro",
      "venue": "UC San Diego",
      "year": 2026,
      "url": "https://doi.org/10.82901/nemar.on006921",
      "cited_by": 0,
      "abstract": "This dataset contains high-density resting-state EEG recordings (64 or 128 channels) from three subject groups: amputees with phantom limb pain, amputees without phantom limb pain, and pain-free intact controls. Approximately 7-minute recordings were acquired with eyes open or closed conditions. The data is organized according to BIDS standards and includes session-level pain questionnaire phenotype data, facilitating accessible reuse for neuroimaging research on phantom limb pain mechanisms.",
