  "citation_details": [
    {
      "title": "Comprehensive methodology for sample enrichment in EEG biomarker studies for Alzheimer’s risk classification",
      "author": "Verónica Henao Isaza, Carlos Andrés Tobón Quintero, John Fredy Ochoa Gómez",
      "venue": "UC San Diego",
      "year": 2026,
      "url": "https://doi.org/10.82901/nemar.on007427",
      "cited_by": 0,
      "abstract": "This dataset presents a comprehensive methodology for sample enrichment in electroencephalography (EEG) biomarker studies designed to classify Alzheimer's disease risk. The study employs systematic approaches to optimize participant selection and EEG data quality for improved biomarker identification and risk stratification in neurodegenerative disease research. The dataset contains EEG recordings and associated clinical data from participants stratified by Alzheimer's risk status, demonstrating the application of enrichment methodology for enhanced biomarker discovery. Sample size and detailed participant demographics are available in the associated publication (Henao Isaza et al., PLOS ONE, 2024).",
