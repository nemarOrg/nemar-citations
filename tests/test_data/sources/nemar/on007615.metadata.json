{"schema_version":"0.4.0","doc_type":"dataset","dataset_id":"on007615","name":"LDAEP and resting-state EEG in healthy women","description":"This dataset comprises resting-state and loudness dependence of auditory evoked potentials (LDAEP) EEG recordings from 69 healthy women aged 19-40, collected at the University of Oslo. It was assembled to investigate the relationship between hormonal contraceptive use and central serotonergic activity as indexed by LDAEP. In addition to EEG data, the dataset includes phenotype data on hormonal contraceptive use, menstrual cycle phase, depressive symptoms (BDI-II), impulsivity (UPPS-P), and lifestyle factors.","source":"nemar","recording_modality":["EEG"],"bids_version":null,"license":"CC0","authors":[{"name":"Henrik Normannseth","name_type":"Personal"},{"name":"Stein Andersson","name_type":"Personal"},{"name":"Christoffer Hatlestad-Hall","name_type":"Personal"}],"anonymous":false,"keywords":[{"term":"EEG"},{"term":"resting state"},{"term":"auditory evoked potentials"},{"term":"Serotonin","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D012701"},{"term":"hormonal contraceptives"},{"term":"impulsivity"},{"term":"Depression","subject_scheme":"MeSH","value_uri":"http://id.nlm.nih.gov/mesh/D003863"}],"related_identifiers":[{"identifier":"https://github.com/nemarDatasets/on007615","identifier_type":"URL","relation_type":"IsDescribedBy"},{"identifier":"https://nemar.org/dataset/on007615","identifier_type":"URL","relation_type":"IsDescribedBy"},{"identifier":"10.3389/fnhum.2025.1647425","identifier_type":"DOI","relation_type":"IsSupplementTo"},{"identifier":"10.21105/joss.01896","identifier_type":"DOI","relation_type":"References"},{"identifier":"10.1038/sdata.2016.44","identifier_type":"DOI","relation_type":"References"},{"identifier":"10.1038/s41597-019-0104-8","identifier_type":"DOI","relation_type":"References"},{"identifier":"10.18112/openneuro.ds007615.v1.0.0","identifier_type":"DOI","relation_type":"IsDerivedFrom"