---
/** A dataset id, linked to its NEMAR page when NEMAR serves one (nm*, on*). */
import { nemarDatasetUrl } from "../lib/nemar";

interface Props {
  id: string;
  class?: string;
}

// `rest` carries the parent's scoped-style attribute, so the parent's class
// rules (e.g. `.ds__id`) still apply to the element rendered here.
const { id, class: className, ...rest } = Astro.props;
const url = nemarDatasetUrl(id);
---

{
  url ? (
    <a class={className} href={url} title={`Open ${id} on NEMAR`} {...rest}>
      {id}
    </a>
  ) : (
    <span class={className} {...rest}>
      {id}
    </span>
  )
}
