---
import BarChart from "../components/BarChart.astro";
import DonutChart from "../components/DonutChart.astro";
import StatCard from "../components/StatCard.astro";
import Base from "../layouts/Base.astro";
import { loadAll } from "../lib/data";
import { MODALITY_META, MODALITY_ORDER, loadModalities } from "../lib/modality";
import { nemarDatasetUrl } from "../lib/nemar";

const { overview, datasets, charts } = loadAll();
const fmt = (n: number) => n.toLocaleString("en-US");
// Three leaderboards, pre-sorted server-side; the toggle swaps which is shown
// (the top-30 by total citations differs from the top-30 by dataset citations,
// so a client-side re-sort of one rendered list would be wrong). Issue #169.
const top = datasets.slice(0, 30);
const topDataset = [...datasets]
  .filter((d) => d.numDatasetCitations > 0)
  .sort((a, b) => b.numDatasetCitations - a.numDatasetCitations)
  .slice(0, 30);
const topPaper = [...datasets]
  .filter((d) => d.numDataPaperCitations > 0)
  .sort((a, b) => b.numDataPaperCitations - a.numDataPaperCitations)
  .slice(0, 30);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const datasetLink = (id: string) => `${base}/dataset/${id}`;

// Trend (histogram) + confidence + modality, consolidated onto the overview.
const bars = charts.temporal.map((p) => ({ label: p.year, value: p.newPapers }));
const confSlices = [
  { label: "High-confidence (≥ 0.4)", value: charts.confidence.high, color: "var(--brand-teal)" },
  {
    label: "Lower-confidence (< 0.4)",
    value: charts.confidence.low,
    color: "var(--color-fg-subtle)",
  },
];
const modalities = loadModalities();
const modCounts = new Map<string, number>();
for (const d of datasets) {
  const m = modalities.get(d.id) ?? "other";
  modCounts.set(m, (modCounts.get(m) ?? 0) + 1);
}
const modSlices =
  modalities.size === 0
    ? []
    : MODALITY_ORDER.filter((m) => modCounts.get(m)).map((m) => ({
        label: MODALITY_META[m].label,
        value: modCounts.get(m) ?? 0,
        color: MODALITY_META[m].color,
      }));
---

<Base title="NEMAR Citations">
  <section class="hero">
    <h1>Dataset citations</h1>
    <p class="hero__sub">
      Citations tracked across NEMAR and OpenNeuro neuroscience datasets, scored for relevance
      and refreshed automatically from the NEMAR catalog.
    </p>
  </section>

  <section class="stats" aria-label="Overview statistics">
    <StatCard value={fmt(overview.datasetCount)} label="Datasets tracked" />
    <StatCard
      value={fmt(overview.uniqueCitations)}
      label="High-confidence citing papers"
      hint={`${fmt(overview.totalCitations)} attributions across datasets`}
    />
    <StatCard
      value={fmt(overview.datasetsWithCitations)}
      label="Datasets with high-confidence citations"
    />
  </section>
  <p class="stats-note">
    Counts include only high-confidence citations and exclude BIDS / methods /
    standards reference papers. {fmt(overview.lowConfidenceTotal)} lower-confidence
    citations are kept and shown per dataset.
  </p>

  <p class="maps-link">
    <a href={`${base}/maps`}>Explore the dataset &amp; citation maps →</a>
  </p>

  {
    bars.length > 0 && (
      <section class="trends" aria-label="Citation trends">
        <h2 class="trends__title">Citation trends</h2>
        <div class="chart-card">
          <header class="chart-card__head">
            <h3>New citations per year</h3>
            <p class="chart-card__cap">High-confidence citing papers first published each year.</p>
          </header>
          <BarChart
            bars={bars}
            xLabel="Year"
            yLabel="Papers"
            unit="papers"
            ariaLabel="New high-confidence citing papers per year"
          />
        </div>
        <div class="chart-row">
          <div class="chart-card">
            <header class="chart-card__head">
              <h3>Citation confidence</h3>
              <p class="chart-card__cap">
                Confidence split of citation-dataset attributions (methods papers excluded).
              </p>
            </header>
            <DonutChart
              slices={confSlices}
              centerLabel="attributions"
              ariaLabel="Confidence split of citation-dataset attributions"
            />
          </div>
          {modSlices.length > 0 && (
            <div class="chart-card">
              <header class="chart-card__head">
                <h3>Datasets by modality</h3>
                <p class="chart-card__cap">
                  Recording modality of datasets with citations (from the NEMAR catalog).
                </p>
              </header>
              <DonutChart
                slices={modSlices}
                centerLabel="datasets"
                ariaLabel="Tracked datasets by recording modality"
              />
            </div>
          )}
        </div>
      </section>
    )
  }

  <section class="browse">
    <div class="browse__head">
      <h2>Top datasets</h2>
      <div class="rank" role="group" aria-label="Rank datasets by">
        <button type="button" class="rank__btn is-active" data-rank="total" aria-pressed="true">
          All citations
        </button>
        <button type="button" class="rank__btn" data-rank="dataset" aria-pressed="false">
          Cites dataset
        </button>
        <button type="button" class="rank__btn" data-rank="paper" aria-pressed="false">
          Cites a paper
        </button>
      </div>
    </div>

    <ol class="ds-list" data-rank-list="total" role="list">
      {
        top.map((d) => (
          <li class="ds">
            <a class="ds__name" href={datasetLink(d.id)}>
              {d.name}
            </a>
            <a class="ds__id" href={nemarDatasetUrl(d.id)} title={`Open ${d.id} on NEMAR`}>
              {d.id}
            </a>
            <span class="ds__count">{fmt(d.numCitations)}</span>
          </li>
        ))
      }
    </ol>

    <ol class="ds-list" data-rank-list="dataset" role="list" hidden>
      {
        topDataset.length > 0 ? (
          topDataset.map((d) => (
            <li class="ds">
              <a class="ds__name" href={datasetLink(d.id)}>
                {d.name}
              </a>
              <a class="ds__id" href={nemarDatasetUrl(d.id)} title={`Open ${d.id} on NEMAR`}>
              {d.id}
            </a>
              <span class="ds__count">{fmt(d.numDatasetCitations)}</span>
            </li>
          ))
        ) : (
          <li class="ds ds--empty">
            No dataset-accession citations yet — this populates as the pipeline
            finds papers that mention dataset accession numbers.
          </li>
        )
      }
    </ol>

    <ol class="ds-list" data-rank-list="paper" role="list" hidden>
      {
        topPaper.length > 0 ? (
          topPaper.map((d) => (
            <li class="ds">
              <a class="ds__name" href={datasetLink(d.id)}>
                {d.name}
              </a>
              <a class="ds__id" href={nemarDatasetUrl(d.id)} title={`Open ${d.id} on NEMAR`}>
              {d.id}
            </a>
              <span class="ds__count">{fmt(d.numDataPaperCitations)}</span>
            </li>
          ))
        ) : (
          <li class="ds ds--empty">No data-paper citations yet.</li>
        )
      }
    </ol>
  </section>

  <script>
    // Swap which pre-sorted leaderboard is visible.
    const rankButtons = document.querySelectorAll<HTMLButtonElement>(".rank__btn");
    const rankLists = document.querySelectorAll<HTMLOListElement>("[data-rank-list]");
    for (const btn of rankButtons) {
      btn.addEventListener("click", () => {
        const rank = btn.dataset.rank;
        for (const b of rankButtons) {
          b.classList.toggle("is-active", b === btn);
          b.setAttribute("aria-pressed", String(b === btn));
        }
        for (const ol of rankLists) {
          ol.hidden = ol.dataset.rankList !== rank;
        }
      });
    }
  </script>
</Base>

<style>
  .hero {
    padding-block: var(--space-6) var(--space-8);
  }
  .hero__sub {
    max-width: var(--max-width-prose);
    color: var(--color-fg-muted);
    font-size: var(--fs-lg);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-5);
  }
  .stats-note {
    margin-top: var(--space-3);
    max-width: var(--max-width-prose);
    font-size: var(--fs-sm);
    color: var(--color-fg-subtle);
  }
  .maps-link {
    margin-top: var(--space-6);
    font-weight: var(--fw-medium);
  }
  .trends {
    margin-top: var(--space-10);
  }
  .trends__title {
    margin-bottom: var(--space-4);
  }
  .chart-row {
    margin-top: var(--space-5);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-5);
  }
  .chart-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    background: var(--color-bg-elevated);
  }
  .chart-card__head {
    margin-bottom: var(--space-4);
  }
  .chart-card__head h3 {
    font-size: var(--fs-lg);
  }
  .chart-card__cap {
    margin-top: var(--space-1);
    font-size: var(--fs-sm);
    color: var(--color-fg-subtle);
  }
  .browse {
    margin-top: var(--space-12);
  }
  .browse__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .rank {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .rank__btn {
    font-size: var(--fs-sm);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm, 4px);
    background: var(--color-bg-subtle);
    color: var(--color-fg-muted);
    cursor: pointer;
  }
  .rank__btn:hover {
    color: var(--color-fg);
  }
  .rank__btn.is-active {
    color: var(--color-fg);
    border-color: var(--brand-teal);
    background: color-mix(in srgb, var(--brand-teal) 12%, transparent);
  }
  .ds--empty {
    display: block;
    color: var(--color-fg-muted);
    font-size: var(--fs-sm);
  }
  .ds-list {
    list-style: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .ds {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }
  .ds:last-child {
    border-bottom: none;
  }
  .ds:hover {
    background: var(--color-bg-subtle);
  }
  .ds__name {
    font-weight: var(--fw-medium);
    color: var(--color-fg);
  }
  .ds__id {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--color-fg-subtle);
  }
  .ds__count {
    font-variant-numeric: tabular-nums;
    font-weight: var(--fw-semibold);
    color: var(--brand-teal);
  }
</style>
